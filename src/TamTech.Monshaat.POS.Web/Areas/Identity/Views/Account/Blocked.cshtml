
@{
    ViewBag.bodyClass = "login_page";
    ViewBag.className = "login_conteiner";
}





<div class="login-wrap col-md-5">
    <header class="header_login text-center">
        <img src="~/Identity/img/logo.png" width="350" />

    </header>


    <div class="form-wrap text-center white-panel p_15">
         <h4> @Localizer["your_are_blocked_title"]</h4>

        @{ 
            string contact_us = $"<a href='{Url.Action("contactus","home",new { Area = "portal" })}' class='btn btn-link'>{Localizer["contact_us"].Value}</a>";
            string homePage = $"<a href='{Url.Action("index","home",new { Area = "portal" })}'  class='btn btn-link'>{Localizer["to_home_page"].Value}</a>";
        }
        <p class="">
            @Localizer["your_blocked_action", contact_us, homePage]
        </p>
    </div>
</div>
