@model TamTech.Monshaat.POS.IdentityService.Models.LoginTamViewModel





@{
    ViewBag.bodyClass = "login_page";
    ViewBag.className = "login_conteiner";
}





<div class="login-wrap col-md-5">
    <header class="header_login text-center">
        <img src="~/Identity/img/logo.png" width="350" />

    </header>


    @Html.Partial("_ValidationSummary")

    <div class="form-wrap">

        @if (Model.EnableLocalLogin)
        {
        <form asp-route="Login" class="form">
            <input type="hidden" asp-for="ReturnUrl" />


            <div class="form-group">
                    <input class="form-control input-lg" placeholder="@Localizer["t_username"]" asp-for="Username" autofocus>
            </div>
            <div class="form-group">
                    <input type="password" class="form-control input-lg" placeholder="@Localizer["password"]" asp-for="Password" autocomplete="off">
            </div>
            @if (Model.AllowRememberLogin)
            {
                @*<div class="form-group login-remember">
                <label asp-for="RememberLogin">
                    <input asp-for="RememberLogin">
                    <strong>Remember My Login</strong>
                </label>
            </div>*@
            }
            <div class="form-group">
                <button class="btn btn-login btn-block btn-lg" name="button" value="login">@Localizer["Login"]</button>

            </div>
            @*<div class="form-group">
                <a href="/Identity/Auth/ForgotPassword" class="btn-link">@Localizer["Forgot_your_passwword"]</a>
            </div>*@

            @*<div class="form-group">
            <a href="@Url.Action("signupbymobilenumber", "account")">Signup new user</a>
        </div>*@

        </form> 

        }

      

    </div>
</div>
