@model TamTech.Monshaat.POS.Web.SDK.Services.Identity.Auth.Models.ResetPassword ;


@{
    ViewBag.bodyClass = "login_page";
    ViewBag.className = "login_conteiner";

 
}





<div class="login-wrap col-md-5">
    <header class="header_login text-center">
        <img src="~/Identity/img/logo.png" width="350" />
    </header>



    @if (TempData["showMessage"] == null)
    {
        @Html.Partial("_ValidationSummary")
        <div class="form-wrap">
            <form class="form " method="post" asp-action="ResetPassword" id="resetpassword">

                <input type="hidden" asp-for="Token" value="@ViewBag.Token" />
                <input type="hidden" asp-for="UserId" value="@ViewBag.UserId" />


                <div class="form-group">
                    <input class="form-control input-lg" type="password" asp-for="NewPassword" placeholder="@Localizer["Current_Password"]" autofocus required>
                </div>
                <div class="form-group">
                    <input class="form-control input-lg" type="password" asp-for="ConfirmPassword" id="ConfirmPassword" placeholder="@Localizer["Confirm_new_Password"]" required>
                </div>
                <div class="form-group">
                    <button class="btn btn-login btn-block btn-lg" name="button" value="Reset">@Localizer["Reset_Password"]</button>
                </div>
                <div class="form-group">
                    <a href="@Url.Action("login", "account")" class="btn-link">@Localizer["Login"]</a>
                </div>
            </form>
        </div>
    }
    else
    {
        <div class="alert alert-success">
            @{
                string login = $"<a href='{Url.Action("login", "account")}'  class='btn-link'>{Localizer["Login"].Value}</a>";
            }
            @Localizer["Congratulations_You_have_successfully_changed_your_password", login]
        </div>
   
    }



</div>







@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
 
        $("#resetpassword").validate({
                errorClass: "invalid-feedback",
                validClass: "valid-feedback",
                rules: {
                    Password: {
                        required: true,
                        minlength: 4
                    },
                    ConfirmPassword: {
                        equalTo: "#NewPassword"
                    }
                }
            });


    </script>


}