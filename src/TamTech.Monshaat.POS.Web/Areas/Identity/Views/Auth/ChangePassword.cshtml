@model TamTech.Monshaat.POS.Web.SDK.Services.Identity.Auth.Models.ChangePassword;


@{
    ViewBag.bodyClass = "login_page";
    ViewBag.className = "login_conteiner";


}
 

<div class="login-wrap col-md-5">
    <header class="header_login text-center">
        <img src="~/Identity/img/logo.png" width="350" />

    </header>



    @if (TempData["showMessage"] == null)
    {
        @Html.Partial("_ValidationSummary")
        <div class="form-wrap">
            <form class="form " method="post" asp-action="changePassword" id="resetpassword">

                <div class="form-group">
                    <input class="form-control input-lg" type="password" asp-for="CurrentPassword" placeholder="@Localizer["Current_Password"]" autofocus required>
                </div>
                <div class="form-group">
                    <input class="form-control input-lg" type="password" asp-for="NewPassword" placeholder="@Localizer["new_password"]" required>
                </div>
                <div class="form-group">
                    <input class="form-control input-lg" type="password" name="ConfirmPassword" id="ConfirmPassword" placeholder="@Localizer["Confirm_new_Password"]" required>
                </div>
                <div class="form-group">
                    <button class="btn btn-login btn-block btn-lg" name="button" value="Reset">@Localizer["Change_Password"]</button>
                </div>
                <div class="form-group">
                    <a href="@Url.Action("index", "home",new { area = "admin"})" class="btn-link m-x-15">@Localizer["Back_To_dashboard"]</a>
                    <a asp-area="identity" asp-action="Logout" asp-controller="Account" class="btn-link">
                         @Localizer["Log_out"]
                    </a>
                </div>

                 
            </form>
        </div>
    }
    else
    {
        <div class="alert alert-success">
           @{ 
                string dashboard = $"<a href='{Url.Action("index", "home", new { Area = "admin" })}'  class='btn-link'>{Localizer["dashboard"].Value}</a>";
           }
            @Localizer["Congratulations_You_have_successfully_changed_your_password" , dashboard]
        </div>

    }



</div>

  
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>

        $("#resetpassword").validate({
                errorClass: "invalid-feedback",
                validClass: "valid-feedback",
                rules: {
                    NewPassword: {
                        required: true,
                        minlength: 4
                    },
                    ConfirmPassword: {
                        equalTo: "#NewPassword"
                    }
                }
            });


    </script>


}