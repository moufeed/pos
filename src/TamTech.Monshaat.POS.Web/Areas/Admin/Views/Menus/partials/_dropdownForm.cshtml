@model MenuItemVm
@{
    var activeLang = DataCultureHelper.GetCurrent(Context.Request.Query);
}
    
    <form asp-action="CreateMenuItemAsync" asp-controller="menus"
          method="post"
          class="form-horizontal form-new form-label-left p-x-5 p-y-3 ut-submenu-form">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary()
            </div>
        }
        <input type="hidden" asp-for="MenuId"   value="@ViewBag.Id" />
        <input type="hidden" asp-for="ItemType"   value="@MenuItemTypeEnum.dropdown.ToString()" />
        <input type="hidden" asp-for="ParentKey"  value="" />
        <input type="hidden" asp-for="Lang" value="@activeLang" />
        <div class="form-group clearfix">
            <label class="control-label col-md-3 col-sm-4"> @Localizer["f_title"] <i class="fa fa-asterisk c-red fz-10 "></i></label>
            <div class="col-md-9 col-sm-8 col-xs-12">
                <input type="text" asp-for="Title"  id="dropdown-Title" class="form-control ut-title-input" required>
            </div>
        </div>
        <div class="form-group clearfix">
            <label class="control-label col-md-3 col-sm-4">@Localizer["f_url"]</label>
            <div class="col-md-9 col-sm-8 col-xs-12">
                <input type="text" asp-for="Url"  id="dropdown-Url" class="form-control">
            </div>
        </div>
        <div class="form-group clearfix">
            <label class="control-label col-md-3 col-sm-4"> @Localizer["f_display_order"] </label>
            <div class="col-md-9 col-sm-8 col-xs-12">
                <input type="number" asp-for="DisplayOrder" id="dropdown-DisplayOrder" step="1" min="0" value="0" class="form-control ut-order-input">
            </div>
        </div>
        <div class=" clearfix text-right">
            <input type="submit" value="@Localizer["add_to_menu"]" class="btn btn-success ut-submenu-send">
            <button type="button" class="btn btn-default" data-dismiss="modal">@Localizer["close"]</button>
        </div>

    </form>
