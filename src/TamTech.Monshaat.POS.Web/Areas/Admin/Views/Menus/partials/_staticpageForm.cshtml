@model MenuItemVm
@{
    var activeLang = DataCultureHelper.GetCurrent(Context.Request.Query);
}

    <form asp-action="@Model.FormAction" asp-controller="menus" method="post"
          class="form-horizontal form-new form-label-left p-x-5 p-y-3 ut-staticpage-form">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary()
            </div>
        }
        <input type="hidden" asp-for="MenuId" value="@ViewBag.MenuId" />
        <input type="hidden" asp-for="ItemType" value="@MenuItemTypeEnum.staticpage.ToString()" />
        <input type="hidden" asp-for="ParentKey" value="" />
        <input type="hidden" asp-for="Lang" value="@activeLang" />
        <div class="form-group clearfix">
            <label class="control-label col-md-3 col-sm-4"> @Localizer["f_title"] <i class="fa fa-asterisk c-red fz-10 "></i></label>
            <div class="col-md-9 col-sm-8 col-xs-12">
                <input type="text" asp-for="Title" id="staticpage-Title" class="form-control ut-title-input" required>
            </div>
        </div>

        <div class="form-group clearfix">
            <label class="control-label col-md-3 col-sm-4"> @Localizer["page"] <i class="fa fa-asterisk c-red fz-10 "></i></label>
            <div class="col-md-9 col-sm-8 col-xs-12">

                <select style="width:100%"
                        asp-for="Url" id="Staticpage-Url"
                        asp-items="ViewBag.StaticPagesSelectList"
                        class="form-control select_picker ut-staticpage-url"
                        required
                        data-live-search="true"
                        data-style="btn-select"></select>
            </div>
        </div>

        <div class="form-group clearfix">
            <label class="control-label col-md-3 col-sm-4"> @Localizer["f_display_order"] </label>
            <div class="col-md-9 col-sm-8 col-xs-12">
                <input type="number" asp-for="DisplayOrder" id="StaticPageDisplayOrder" step="1" value="0" min="0" class="form-control ut-order-input">
            </div>
        </div>
        <div class=" clearfix text-right">
            @{ string btn = Model.FormAction.Equals("EditMenuItemAsync") ? "edit" : "add_to_menu"; }
            <input type="submit" value="@Localizer[btn]" class="btn btn-success ut-staticpage-send">
            <button type="button" class="btn btn-default" data-dismiss="modal">@Localizer["close"]</button>
        </div>

    </form>
