          "send_error" :"@Localizer["send_error"]",
        @switch (lang){
        case "ar":
        <text>
         "Slug_ar" : "@Localizer["Slug_ar"]",
         "Title_ar" : "@Localizer["Title_ar"]",
         "MainImage_ar" : "@Localizer["MainImage_ar"]",
         "VideoUrl_ar": "@Localizer["VideoUrl_ar"]",
         "Content_ar": "@Localizer["Content_ar"]",
         "Image_ar": "@Localizer["Image_ar"]",
        </text>
        break;
        case "en":
        <text>
         "Slug_en" : "@Localizer["Slug_en"]",
         "Title_en" : "@Localizer["Title_en"]",
         "MainImage_en" : "@Localizer["MainImage_en"]",
         "VideoUrl_en": "@Localizer["VideoUrl_en"]",
         "Content_en": "@Localizer["Content_en"]",
         "Image_en": "@Localizer["Image_en"]",
         </text>
        break;
}
}
</script>
