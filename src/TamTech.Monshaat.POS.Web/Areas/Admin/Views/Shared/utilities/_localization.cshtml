         "confirm_title" : "@Localizer["confirm_title"]",
         "confirm_text" : "@Localizer["confirm_text"]",
         "confirm_yes" : "@Localizer["confirm_yes"]",
         "Confirm_cancel" : "@Localizer["Confirm_cancel"]",
         "characters" : "@Localizer["characters"]",
         "text_will_be_truncated" : "@Localizer["text_will_be_truncated"]",
         "text_count_be_more_than" : "@Localizer["text_count_be_more_than"]",
         "updateted_successfully" : "@Localizer["updateted_successfully"]",
         "something_wrong" : "@Localizer["something_wrong"]",
         "published_successfully" : "@Localizer["published_successfully"]",
         "unpublished_successfully" : "@Localizer["unpublished_successfully"]",
