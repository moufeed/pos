@model PagedResultModel<List<SectorDto>>
 
@{
    ViewData["Title"] = Localizer["sectors"];
    ViewData["UnitTestPageClass"] = "ut-sectors-index";
    var activeLang = DataCultureHelper.GetCurrent(Context.Request.Query);
}

<div class="clearfix">
    <div class="page-title">
        <div class="title_left">
            <h3>@Localizer["sectors"] <small></small></h3>
        </div>
        <div class="title_right"> 
            <a href="@Url.AdminUrl("Create" , "Sectors")"
               class="btn btn-blue btn-add-new ut-create-btn">
                <i class="fa fa-plus"></i>
                @Localizer["new_sector"]
            </a>
        </div>
    </div>
</div>



<if include-if="Model != null">
<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        @{
            ViewBag.LanguageTabsRouteValues = new Microsoft.AspNetCore.Routing.RouteValueDictionary { };
        }
        @await Html.PartialAsync("~/Areas/Admin/Views/Shared/partials/_LanguageTabs.cshtml")

        <div class="x_panel p-x-0">

            <div class="x_content">
                <partial name="_Filters.cshtml" model="ViewBag.FilterModel" />

                <div class="table-responsive">
                    <table class="table table-middle table-striped posts-table" id="sectorsTable">

                        <thead>
                        <th width="100" class="text-center">@Localizer["t_icon"]</th>
                        <th>@Localizer["t_title"]</th>
                        <th>@Localizer["t_description"]</th>
                        <th>@Localizer["t_display_order"]</th>

                        <th width="100" class="text-center">@Localizer["t_visibility"]</th>
                        <th width="175">@Localizer["t_actions"]</th>
                        </thead>
                        <tbody>
                            <if include-if="Model.Data.Count > 0">
                                @foreach (var item in Model.Data)
                            {

                                <tr id="tr-@item.Id">
                                    <td class="text-center">
                                        <div class="tabel-img-circle">
                                            @{ 
                                                string _url = Url.FileUrl(CommonConstants.ImgAction, new { img = Helpers.GetFileNameFromUrl(item.Icon), type = FileTypesEnum.SectorIcon });
                                                string _icon = !string.IsNullOrEmpty(item.Icon) ? _url : Url.Content("~/Admin/img/noimage.jpg");
                                            }
                                            <img src="@_icon" alt="" width="75" />
                                        </div>
                                    </td>
                                    <td style="min-width:150px">
                                        <a data-toggle="tooltip"
                                           data-placement="top"
                                           title="@Localizer["t_edit"]"
                                           href="@Url.AdminUrl("Edit" ,"Sectors",new { id = item.Id })" class="ser-title underline">@item.Name</a>
                                    </td>
                                    <td>
                                        <div class="s-summary">
                                            @{
                                                string Description = (!string.IsNullOrWhiteSpace(item.Description)) ? Regex.Replace(item.Description, "<.*?>", String.Empty) : "";
                                            }
                                            @Html.Raw(Description)
                                        </div>
                                    </td>
                                    <td>
                                        @item.DisplayOrder
                                    </td>
                                    @*<td>
                                <if include-if="item.IsOfficial">
                                    <i class="fa fa-check-circle-o" aria-hidden="true"></i>
                                </if>
                                <if exclude-if="item.IsOfficial">
                                    <i class="fa fa-ban" aria-hidden="true"></i>
                                </if>
                            </td>*@
                                    <td>
                                        <if include-if="item.Locked">
                                            <if include-if="item.Published">
                                                <span class="label label-success">
                                                    <i class="fa fa-eye "></i>
                                                    @Localizer["t_published"]
                                                </span>
                                            </if>
                                            <if exclude-if="item.Published">
                                                <span class="label label-danger">
                                                    <i class="fa fa-eye-slash "></i>
                                                    @Localizer["t_unpublished"]
                                                </span>
                                            </if>
                                        </if>
                                        <if exclude-if="item.Locked">
                                            <span data-toggle="tooltip"
                                                  data-placement="@(activeLang == "ar" ? "right" : "left")"
                                                  data-status="true"
                                                  title="@Localizer["t_unpublish"] / @Localizer["t_publish"]">

                                                <input class="tgl tgl-flat toggle__publish"
                                                       data-url="@Url.AdminUrl("PublishAsync","sectors" , new { id = item.Id})"
                                                       id="@item.Id"
                                                       type="checkbox"
                                                       @((item.Published) ? "<text> checked </text>" : "") />
                                                <label class="tgl-btn" for="@item.Id"></label>
                                            </span>

                                        </if>
                                    </td>
                                    <td>
                                        @{
                                            string placement = activeLang == "ar" ? "right" : "left";
                                        }
                                        <div>
                                            <a data-toggle="tooltip"
                                               data-placement="@placement"
                                               title="@Localizer["t_details"]"
                                               href="@Url.AdminUrl("Details","sectors",new { id = item.Id })"
                                               class="btn btn-view btn-round ut-detail-btn"><i class="fa fa-info "></i></a>

                                            <a data-toggle="tooltip"
                                               data-placement="@placement"
                                               title="@Localizer["t_edit"]"
                                               href="@Url.AdminUrl("Edit" ,"sectors",new { id = item.Id })"
                                               class="btn btn-edit btn-round ut-edit-btn"><i class="fa fa-edit "></i></a>

                                            <if include-if="item.Locked">
                                                <span data-toggle="tooltip"
                                                      data-placement="@placement"
                                                      class="btn-locked btn-round"
                                                      title="@Localizer["locked_by_system"]"><i class="fa fa-lock"></i></span>
                                            </if>

                                            <if exclude-if="item.Locked">
                                                <a data-toggle="tooltip"
                                                   data-placement="@placement"
                                                   data-id="@item.Id"
                                                   data-url="@Url.AdminUrl("DeleteAsync", "sectors", new { id = item.Id })"
                                                   title="@Localizer["t_remove"]"
                                                   class="btn btn-remove btn-round delete-sector ut-remove-btn"><i class="fa fa-times "></i></a>
                                            </if>



                                        </div>
                                    </td>
                                </tr>

                            }
                            </if>

                            <if include-if='Model.Data.Count == 0'>
                                <tr>
                                    <td colspan="6" class="text-center">
                                        <p class="empty_row">
                                            <i class='fa fa fa-exclamation-circle'></i>
                                            @Localizer["no_data_table"]
                                        </p>
                                    </td>
                                </tr>
                            </if>


                        </tbody>
                    </table>
                </div>

               
                <hr class="m-y-2" />
                <pagination controller-name="sectors" filter-model="ViewBag.FilterModel" pagniation-model="Model.Pagination" total="true"></pagination>
            </div>
        </div>
    </div>
</div>
</if>

<if exclude-if="Model != null">
   <partial name="~/Areas/Admin/Views/Shared/_empty.cshtml"/>
</if>

 






@section Scripts{
    <script src="~/Admin/js/sectors.min.js"></script>
} 