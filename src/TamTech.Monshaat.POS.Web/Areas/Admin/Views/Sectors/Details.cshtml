@model SectorDto
@{
    ViewData["Title"] = Localizer["sectors_details"];
    ViewData["UnitTestPageClass"] = "ut-sector_details";
    var activeLang = DataCultureHelper.GetCurrent(Context.Request.Query);
}



<div class="clearfix">
    <div class="page-title">
        <div class="title_left">
            <h3> @Localizer["sectors_details"] <small> </small></h3>
        </div>
        <div class="title_right">
            <a asp-action="Index"
               class="btn btn-blue"><span class="fa fa-chevron-left"></span>@Localizer["back_to_list"]</a>
        </div>
    </div>
</div>



<if include-if='Model != null'>
<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">

        @{
            ViewBag.LanguageTabsRouteValues = new Microsoft.AspNetCore.Routing.RouteValueDictionary { { "id", Model.Id } };
        }
        @await Html.PartialAsync("~/Areas/Admin/Views/Shared/partials/_LanguageTabs.cshtml")



        <div class="x_panel">
            <div class="x_content p-y-5 ">
                <div class="form-group clearfix">
                    <strong class="control-label col-md-2 col-sm-4 col-xs-12">@Localizer["title"]</strong>
                    <strong class="col-md-8 col-sm-8 col-xs-12">@Model.Name</strong>
                </div>
                <hr />
                <ul class="clearfix metalist list-unstyled">
                    <li class="col-md-4 col-xs-12 col-sm-4">
                        <strong>@Localizer["status"]</strong>
                        @if (Model.Published)
                        {
                            <span class="c-green"> <i class="fa fa-check" aria-hidden="true"></i>@Localizer["published"]</span>
                        }
                        else
                        {
                            <span class="c-red"> <i class="fa fa-times" aria-hidden="true"></i> @Localizer["unpublished"]</span>
                        }

                    </li>
                    <li class="col-md-4 col-xs-12 col-sm-4">
                        <strong> @Localizer["created_date"]</strong>
                        <span>@Model.CreatedDate</span>
                    </li>
                    <li class="col-md-4 col-xs-12 col-sm-4">
                        <strong> @Localizer["modified_date"]</strong>
                        <span>@Model.ModifiedDate</span>
                    </li>
                </ul>
                <hr />
                <div class="form-group clearfix">
                    <strong class="control-label col-md-2 col-sm-4 col-xs-12"> @Localizer["slug"]</strong>
                    <strong class="col-md-8 col-sm-8 col-xs-12 ut-sevices_slug">@Model.Slug</strong>
                </div>

                <hr />
                <div class="form-group clearfix">
                    <div class="col-md-2 col-sm-3 col-xs-12">
                        <strong> @Localizer["f_description"]</strong>
                    </div>
                    <div class="col-md-8 col-sm-8 col-xs-12">
                        @Html.Raw(Model.Description)
                    </div>
                </div>
                <hr />

                <div class="form-group clearfix">
                    <div class="col-md-2 col-sm-3 col-xs-12">
                        <strong> @Localizer["t_icon"]</strong>
                    </div>
                    <div class="col-md-8 col-sm-8 col-xs-12">

                        <img src="@(!string.IsNullOrEmpty(Model.Icon) ? Model.Icon : Url.Content("~/Admin/img/noimage.jpg"))" style="max-width:300px" />


                    </div>
                </div>
                <hr />

                <div class="clearfix">
                    <div class="col-md-2 col-xs-12 col-sm-3">
                        <strong> @Localizer["t_isOfficial"]</strong>
                    </div>
                    <div class="col-md-8 col-xs-12 col-sm-8">
                        <if include-if="@Model.IsOfficial">
                            <i class="fa fa-check-circle-o" aria-hidden="true"></i>
                        </if>
                        <if exclude-if="@Model.IsOfficial">
                            <i class="fa fa-ban" aria-hidden="true"></i>
                        </if>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</if>

<if exclude-if="Model != null">
   <partial name="~/Areas/Admin/Views/Shared/_empty.cshtml"/>
</if>