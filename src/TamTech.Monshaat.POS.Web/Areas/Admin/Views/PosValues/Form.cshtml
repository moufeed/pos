@model ValueVM
@{
    string PageTitle = ViewBag.IsEditMode ? Localizer["value_edit"].Value : Localizer["value_create"].Value;

    ViewData["UnitTestPageClass"] = "ut-value-form";
    ViewData["Title"] = PageTitle;
    ViewData["relatedController"] = "PosAttributes";
}
<partial name="~/Areas/Admin/Views/Values/Form.cshtml" />



@section Styles{

    <link href="~/Admin/lib/select2/dist/css/select2.min.css" rel="stylesheet" />
 
}

@section Scripts{
    <script src="/Admin/lib/select2/dist/js/select2.js"></script>

    <partial name="_ValidationScriptsPartial" />

    <script>
        $('.select_picker').select2();
         $('#valuesForm').validate({
            errorClass: "invalid_field",
            validClass: "valid_field",
            ignore: ".ignore"
        });
    </script>


}