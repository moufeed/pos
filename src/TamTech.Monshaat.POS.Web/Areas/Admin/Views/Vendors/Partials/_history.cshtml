@model List<VendorStatusHistoryDto>

<div class="table-responsive">
    <table class="table table-middle table-striped posts-table" id="sectorsTable">
        <thead>
            <tr>
                <th>@Localizer["previous_status"]</th>
                <th>@Localizer["action_name"]</th>
                <th>@Localizer["current_status_name"]</th>
                <th width="150">@Localizer["l_date"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (VendorStatusHistoryDto item in Model)
            {
                <tr>
                    <td>
                        <p class="p-y-2 m-0">
                            @item.PreviousStatusName
                        </p>
                    </td>
                    <td>
                        @item.ActionName<br>

                    </td>
                    <td>@item.CurrentStatusName</td>
                    <td dir="ltr" class="text-center">@item.ProcessDate.ToString("yyyy/MM/dd -  hh:mm tt") </td>

                </tr>
            }
        </tbody>
    </table>

</div>