@model VendorFormVm
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["vedor_register"];
    string FormAction = ViewContext.RouteData.Values["Action"].ToString();
    var IsVendorRole = User.Identity.GetUserRolesCommaSeparated()?.Equals(TamTech.Monshaat.POS.Web.SDK.Core.Settings.Utilities.SettingsHelpers.VendorRoleName, StringComparison.InvariantCultureIgnoreCase);
}

<vc:header slugs="@(new List<SlugModel>())"></vc:header>

@*<if include-if="Model != null">*@


<section class="create-vendor-page pt-75  pb-50" data-fix-height>
    <div class="container">

        <div class="row justify-content-center">
            <div class="col-md-11 col-lg-8">
                <header class="vendor-form-header mb-35">
                    <if exclude-if="Model != null && Model.VendorId != Guid.Empty &&  (IsVendorRole == null || !(bool)IsVendorRole )">
                        <h3 class="mb-25">
                            @Localizer[FormAction.Equals("edit", StringComparison.OrdinalIgnoreCase) ? "edit_information" : "vedor_register"]
                        </h3>
                    </if>
                </header>
                <partial name="~/Areas/Portal/Views/Vendor/partials/_Vform.cshtml" model="Model" />
            </div>
        </div>

    </div>
</section>
<partial name="~/Areas/Portal/Views/Shared/partials/_TopFooter.cshtml" />
@section Footer{


    <script src="~/Portal/js/validation.min.js"></script>
    <script src="~/Portal/js/vendor.f.min.js"></script>

    <if include-if='TempData.ContainsKey("RegisterSuccess")'>
        @{
            TempData.Remove("RegisterSuccess");
        }
        <partial name="~/Areas/Portal/Views/Vendor/partials/_RegisterSuccessModal.cshtml" />
    </if>

    <if include-if='TempData.ContainsKey("UpdateSuccess")'>
        @{
            TempData.Remove("UpdateSuccess");
        }
        <partial name="~/Areas/Portal/Views/Vendor/partials/_UpdateSuccessModal.cshtml" />
    </if>

}
@*</if>


     <if exclude-if="Model != null">
        <partial name="~/Areas/Portal/Views/Shared/partials/_Error_widget.cshtml" />
    </if>*@
