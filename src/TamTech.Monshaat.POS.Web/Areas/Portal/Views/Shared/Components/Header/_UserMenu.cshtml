@{
    Layout = null;
}
<div class="dropdown usermenu">
    <if include-if="User.Identity.IsAuthenticated ">
        <button class="btn btn-white p-x-15 m-x-5" type="button" data-toggle="dropdown" aria-haspopup="true"
                aria-expanded="false">
            <i class="fas fa-ellipsis-v"></i>
            <i class="fas fa-user"></i>
        </button>
        <div class="dropdown-menu">
            <if include-if="ViewBag.IsLoogedIn">
                <a class="dropdown-item" asp-action="info" asp-controller="Vendor">
                    <i class="far fa-address-card"></i>
                    @Localizer["supplier_information"]
                </a>

                <a class="dropdown-item" asp-action="edit" asp-controller="Vendor">
                    <i class="fas fa-user-edit"></i>
                    @Localizer["edit_vendor_information"]
                </a>
                <a class="dropdown-item" asp-action="Index" asp-controller="Vendor">
                    <i class="fas fa-store"></i>
                    @Localizer["pos_manager"]
                </a>
            </if>
            <a class="dropdown-item" href="/OAuth/Logout"><i class="fas fa-sign-out-alt"></i> @Localizer["Logout"]</a>
        </div>
    </if>
    <if exclude-if="User.Identity.IsAuthenticated">
        <a href="/OAuth/Login?returnUrl=@Context.Request.Path"
           class="btn btn-white p-x-15 m-x-5 m-t5"
           title="@Localizer["login"]"
           data-toggle="tooltip" data-placement="top"
           aria-expanded="false">
            <i class="fas fa-sign-in-alt m-0"></i>
        </a>
    </if>
</div>