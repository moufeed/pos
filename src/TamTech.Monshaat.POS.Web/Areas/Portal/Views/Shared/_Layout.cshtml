@{
   Layout = null;
    string lang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
     TamTech.Monshaat.POS.Web.Models.VMs.Shared.Biography.BiographyInfoVm biographiesInfo = null;
   
     if (TamTechSDK.Web.Controllers.Portal.PublicBaseController.HtmlRenderCounter == 1)
    { 
        @inject TamTech.Monshaat.POS.Web.Core.Biographies.IBiographiesManager _biographiesManager
          biographiesInfo = (await _biographiesManager.GetInfoAsync());
        ViewBag.BiographyLogo = biographiesInfo.Logo;  
    }
  }


<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="Content-Type" content="application/xhtml+html; charset=utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="shortcut icon" href="~/Portal/img/favicon.png" type="image/x-icon">
    <link rel="icon" href="~/Portal/img/favicon.ico" type="image/x-icon">
    @RenderSection("SEO", required: false)
    @RenderSection("meta", required: false)
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.8.1/css/all.css" integrity="sha384-50oBUHEmvpQ+1lW4y57PTFmhCaXp0ML5d60M1M7uH2+nqUivzIebhndOJK28anvf" crossorigin="anonymous">
    @{

        var styleFile = (lang == "ar") ? "main-rtl.min.css" : "main-ltr.min.css";
    }

    <link rel="stylesheet" href="~/Portal/css/@styleFile" type="text/css" asp-append-version="true">
    @RenderSection("header", required: false)
</head>
<body class="@ViewData["PageClass"]">

    @{
        var controller = ViewContext.RouteData.Values["Controller"].ToString();
        var action = ViewContext.RouteData.Values["Action"].ToString();
    }

    @if (string.Equals(controller, "home", StringComparison.OrdinalIgnoreCase)
&& string.Equals(action, "index", StringComparison.OrdinalIgnoreCase))
    {

        List<SlugModel> mod = new List<SlugModel>();

        <partial name="~/Areas/Portal/Views/Shared/partials/_Header.cshtml" model="mod" />
    }

    
    @RenderBody()



    @if (TamTechSDK.Web.Controllers.Portal.PublicBaseController.HtmlRenderCounter == 1)
    {
          @await Html.PartialAsync("~/Areas/Portal/Views/Shared/partials/_Footer.cshtml", new TamTech.Monshaat.POS.Web.Models.Portal.Partials.FooterVm { BiographyInfo = biographiesInfo })
          TamTechSDK.Web.Controllers.Portal.PublicBaseController.HtmlRenderCounter++;
    }
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>

    <script>
        window.website ={
            lang : '@lang'
        }
    </script>
    <script src="~/Portal/js/script.min.js" asp-append-version="true"></script>
    @RenderSection("footer", required: false)
</body>
</html>
