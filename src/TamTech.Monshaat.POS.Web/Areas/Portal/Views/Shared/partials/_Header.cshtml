
@model List<SlugModel>
@{ 
    string _lang = null;
    string controller = null;
    string action = null;
    TamTech.Monshaat.POS.Web.Models.VMs.Shared.Biography.BiographyInfoVm biographiesInfo = null;
    if (TamTechSDK.Web.Controllers.Portal.PublicBaseController.HtmlRenderCounter == 1)
    {
        _lang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
        controller = ViewContext.RouteData.Values["Controller"].ToString();
        action = ViewContext.RouteData.Values["Action"].ToString();
        ViewBag.IsLoogedIn = User.Identity.IsAuthenticated &&
       TamTech.Monshaat.POS.EFile2.Utilities.Helpers.VendorRole.Equals(User.Identity.GetUserRolesCommaSeparated(), StringComparison.InvariantCultureIgnoreCase);
        if (ViewBag.BiographyLogo == null)
        {
            @inject TamTech.Monshaat.POS.Web.Core.Biographies.IBiographiesManager _biographiesManager
            biographiesInfo = (await _biographiesManager.GetInfoAsync());
            ViewBag.BiographyLogo = biographiesInfo.Logo;
        }
        
    }

}

<header class="main-header">
    <div class="container">
        <div class="row justify-content-between align-items-center align-items-md-start ">
            <div class="col-12 col-sm-auto col-md-4 col-lg-3 col-xl-4 ">
                <a asp-action="index" asp-controller="home" class="main_logo">
                    <img src="@ViewBag.BiographyLogo" alt="@ViewData["Title"]">
                </a>

            </div>
            <div class="col-12 col-sm-auto col-md-8 col-lg-auto col-xl-auto mr-auto ">

                <nav class="navbar navbar-expand-lg navbar-dark main-navbar justify-content-md-end">
                    <div class="  d-none d-md-flex d-lg-none">
                        <if exclude-if="ViewBag.IsLoogedIn">
                            <a asp-action="Register" asp-controller="Vendor" class="btn btn-white mx-15">@Localizer["vedor_register"]</a>
                        </if>
                        <partial name="~/Areas/Portal/Views/Shared/partials/_UserMenu.cshtml" />
                    </div>


                    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#Menu" aria-controls="Menu" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>




                    <div class="collapse navbar-collapse main_menu" id="Menu">
                        @if (TamTechSDK.Web.Controllers.Portal.PublicBaseController.HtmlRenderCounter == 1)
                        {
                                <menu></menu> 
                        }  
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <if exclude-if="ViewBag.IsLoogedIn">
                                    <a asp-action="Register" asp-controller="Vendor" class="nav-link d-md-none">@Localizer["vedor_register"]</a>
                                </if>
                            </li>
                        </ul>

                    </div>
                </nav>
            </div>
            <div class="col-12 col-md-auto col-xl-auto d-none d-lg-flex mt-5">
                <if exclude-if="ViewBag.IsLoogedIn">
                    <a asp-action="Register" asp-controller="Vendor" class="btn btn-white mx-15 mt-5">@Localizer["vedor_register"]</a>
                </if>
                <partial name="~/Areas/Portal/Views/Shared/partials/_UserMenu.cshtml" />
            </div>
        </div>
    </div>
</header>
