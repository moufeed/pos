
@model PosFormVm
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["pos_details"];

    string FormAction = ViewContext.RouteData.Values["Action"].ToString();

    string EditAction = "EditPOS";

}
    <vc:header slugs="@(new List<SlugModel>())"></vc:header>

<section class="create-pos-page pt-75  pb-50">
    <div class="container">

        <div class="row justify-content-center">
            <div class="col-md-11 col-lg-8">
                <header class="c-pos-header mb-35">
                    <h3 class="mb-25">
                        @Localizer["add_pos_system"]
                    </h3>
                    <p class="font-bold">@Localizer["follow_steps"]</p>
                </header>
                <form asp-action="@FormAction" method="post" enctype="multipart/form-data" id="createPosForm" class="pos-form ">
                    <input type="hidden" name="VendorId" value="@Model.VendorId" />
                    <input type="hidden" name="Lang" value="@System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName" />
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger"></div>
                    }
                    @if (ViewBag.UploadedFiles != null)
                    {
                        <input type="hidden" name="UploadedFiles" value="@ViewBag.UploadedFiles" id="UploadedFiles">
                    }
                    @if (FormAction.Equals(EditAction))
                    {
                        <input type="hidden" asp-for="Id">
                    }

                    <div class="step white-panel   active" data-step="1">
                        <h4>@Localizer["pos_some_information"]</h4>
                        <div class="form-group">
                            <label asp-for="Name">@Localizer["Name"] <small class="fas fa-star-of-life fz-6"></small></label>
                            <input type="text" asp-for="Name" class="form-control" 
                                   placeholder="@Localizer["system_name"]" required 
                                   data-remote='@Url.Action("ValidatePosNameIsExist")' data-msg-remote="@Localizer["name_already_exists"]" 
                                   data-id="@(FormAction.Equals(EditAction) ? Model.Id.ToString() :"")"/>
                            <span asp-validation-for="Name" class="text-danger invalid_field"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="TypeId">@Localizer["type"] <small class="fas fa-star-of-life fz-6"></small></label>
                            <select class="form-control select-list" asp-for="TypeId" asp-items="ViewBag.TypsSelect" required data-placeholder="@Localizer["system_type"]"></select>
                            <span asp-validation-for="TypeId" class="text-danger invalid_field"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="About">@Localizer["pos_brief"] <small class="fas fa-star-of-life fz-6"></small></label>
                            <textarea aria-describedby="AboutHelp" class="form-control" asp-for="About" rows="8" placeholder="@Localizer["write_details_here"]" required data-rule-maxwords="300"></textarea>
                            <small id="AboutHelp" class="form-text text-muted">@Localizer["word_count", 300]</small>
                            <span asp-validation-for="About" class="text-danger invalid_field"></span>
                        </div>
                        <if include-if="ViewBag.UploadedFiles != null">
                            @{
                                string imgstr = ViewBag.UploadedFiles;
                                List<string> images = imgstr.Split(";;").ToList();

                            }
                            <div class="d-flex flex-wrap align-items-start">
                                @{
                                    int ind = 0;
                                }
                                @foreach (var img in images)
                                {
                                    if (!string.IsNullOrEmpty(img))
                                    {
                                        <span id="img-@ind">
                                            <button class="btn btn-link position-absolute delete-image" data-href="@Url.Action("DeleteImage")" data-image="@img" type="button" data-target="#img-@ind">
                                                <i class="far fa-times-circle"></i>
                                            </button>
                                            <img src="@Url.FileUrl(CommonConstants.ImgAction,  new { img =  Helpers.GetFileNameFromUrl(img) ,type = FileTypesEnum.POSImage })" class="img-thumbnail" width="150" />
                                        </span>
                                        ind++;
                                    }
                                }
                            </div>
                        </if>
                        @{
                        int maxImages = 8;
                        }
                    <div class="attachment-area form-group" data-id="addImages">
                        <label>@Localizer["add_images"] <small class="fas fa-star-of-life fz-6"></small></label>
                        <div class="box__input @(ViewBag.UploadedCount == maxImages ? "disabled" :"") ">
                            <label for="Attachments">
                                <i class="fas fa-cloud-upload-alt"></i>
                            </label>

                            <input type="file" id="addImages"
                                   class="box__file input-file"
                                   accept="image/png, image/jpeg" 
                                   name="NewImage"
                                   data-msg-require_from_group="@Localizer["upload_at_least_one_file"]"
                                   data-maximages="@(ViewBag.UploadedCount > 0 ? (maxImages - ViewBag.UploadedCount) : maxImages)"
                                   />
                            <label for="addImages" class="file-btn">
                                <strong> @Localizer["choose_file"]</strong>
                            </label>

                        </div>
                        <span asp-validation-for="Attachments" class="text-danger invalid_field Attachments-errors"></span>
                        <small id="AttachmentsHelp" class="form-text text-muted">@Localizer["add_pos_images", ViewBag.UploadedCount > 0 ? (maxImages - ViewBag.UploadedCount) : maxImages]  </small>

                    
                        <ul class="list-unstyled list-files" id="files-info"></ul>
                        <div id="inputsfiles" class="hidden"> </div>
                    </div>
                    </div>

                    <div class="step white-panel " data-step="2">

                        <div class="form-group">
                            <label asp-for="SectorId" class="h4 mb-25">@Localizer["choose_sector_for_pos"]</label>
                            <div class="clearfix sectors_row owl-carousel"  
                                 data-items="5" data-xs-items="2" 
                                 data-sm-items="2" data-md-items="4" data-lg-items="4" data-xl-items="5"  data-rtl="true" data-margin="5"  data-dots="true">
                                <if include-if="ViewBag.sectors != null && ViewBag.sectors.Count > 0">
                                    @{ List<SectorDto> sectors = (List<SectorDto>)ViewBag.sectors; }

                                    @foreach (SectorDto item in sectors)
                                    {
                                        <div class="item ">
                                            <input type="radio" asp-for="SectorId" value="@item.Id" id="@item.Id" class="sectors" />
                                            <label for="@item.Id" class="d-flex justify-content-around align-items-center flex-column">
                                                <span class="s-icon">
                                                    <if include-if="string.IsNullOrEmpty(item.Icon)">
                                                        <img src="~/Portal/img/icons/sector.png" alt="@item.Name" />
                                                    </if>
                                                    <if exclude-if="string.IsNullOrEmpty(item.Icon)">
                                                        @{ 
                                                               string _url = Url.FileUrl(CommonConstants.ImgAction, new { img = Helpers.GetFileNameFromUrl(item.Icon), type = FileTypesEnum.SectorIcon });
                                                        }
                                                        <img src="@_url" alt="@item.Name" />
                                                    </if>
                                                </span>
                                                <b class="d-block mt-5">
                                                    @item.Name
                                                </b>
                                            </label>
                                        </div>
                                    }
                                </if>
                            </div>
                            <span asp-validation-for="SectorId" class="text-danger invalid_field "></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="OtherSector">@Localizer["other_sector"]</label>
                            <input type="text" asp-for="OtherSector" class="form-control sectors" />
                            <span asp-validation-for="OtherSector" class="text-danger invalid_field "></span>
                        </div>
                        <span class="text-danger invalid_field sectors-error"></span>
                    </div>


                    <div class="step white-panel" data-step="3">
                        <if include-if="ViewBag.attributes != null">
                            <partial name="~/Areas/Portal/Views/Vendor/partials/_attributes.cshtml" model="Model" />
                        </if>
                    </div>

                    <div class="form-group text-left mt-50">
                         
                        <a asp-action="index" class="btn btn-outline-success p-x-20">@Localizer["cancel"]</a>
                        <button type="submit" class="btn btn-green c-white p-x-50">

                            @Localizer[(FormAction == "CreatePOS") ? "add" : "update"]
                        </button>
                    </div>

                    
                </form>
            </div>
        </div>
    </div>
</section>

<partial name="~/Areas/Portal/Views/Shared/partials/_TopFooter.cshtml" />

@section  header{ 
 }
@section Footer{
     <script src="~/Portal/js/carousel.min.js"></script>
     <script src="~/Portal/js/plugins/select2.min.js"></script>
    <script src="~/Portal/js/validation.min.js"></script>
    <script src="~/Portal/js/pos.f.min.js"></script>
}