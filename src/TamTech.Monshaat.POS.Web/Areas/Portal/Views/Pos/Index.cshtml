@model PagedResultModel<List<PosDto>>
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["pos_details"];

    List<SlugModel> SlugModel = new List<SlugModel>();
}

<partial name="~/Areas/Portal/Views/Shared/partials/_Header.cshtml" model="SlugModel" />

<if include-if="Model != null">
    <if include-if="   Model.Data != null">
        <section class="vendor-page pt-75 pb-50" @((Model.Data.Count < 2) ? "data-fix-height" : "")>

            <div class="container">

                <div class="row no-gutters ">
                    <div class="col-12">

                        @foreach (var item in Model.Data)
                        {
                            <div class="white-panel p-4 b-shadow mb-25" id="pos-@item.Id">
                                <div class="actions d-flex justify-content-between align-items-center">

                                    <span class="badge badge-pill badge-@item.StatusOptions c-white">@item.StatusName</span>



                                    <nav class="actions-nav btn-group">
                                        <if include-if="!string.IsNullOrEmpty(item.Notes)">
                                            <a href="#ReasonPosModal" class="btn btn-outline-info btn-note " role="button" data-toggle="modal" data-msg="@item.Notes" data-status="@item.StatusName" data-options="badge-@item.StatusOptions">
                                                @Localizer["l_notes"]
                                                <i class="far fa-sticky-note"></i>
                                            </a>
                                        </if>

                                        <a asp-action="EditPOS" asp-route-id="@item.Id" class="btn btn-outline-warning m-x-5">
                                            @Localizer["edit"]
                                            <i class="far fa-edit"></i>
                                        </a>
                                        <a href="#" class="btn btn-outline-danger m-x-5 " data-toggle="modal" data-target="#DeletePosModal" data-pos="@item.Name" data-url='@Url.Action("DeletePos",new{id=item.Id})' data-id="@item.Id">
                                            @Localizer["delete"]
                                            <i class="far fa-trash-alt"></i>
                                        </a>

                                    </nav>
                                </div>
                                <div class="row">
                                    <div class="col-md-3">
                                        <div class="owl-carousel v-pos-images text-center" data-singleitem="true" data-dots="true" data-rtl="true">
                                            <if include-if="item.Images.Count > 0">
                                                @foreach (var img in item.Images)
                                                {
                                                    <a asp-action="pos" asp-route-slug="@item.Slug">
                                                        <img src="@Url.FileUrl(CommonConstants.ImgAction,  new { img =  img ,type = FileTypesEnum.POSImage })" class="pos-image ignore" alt="@item.Name">
                                                    </a>
                                                }
                                            </if>
                                            <if exclude-if="item.Images.Count > 0">
                                                <a asp-action="pos" asp-route-slug="@item.Slug">
                                                    <img src="~/portal/img/pos-empty.jpg" class="img-fluid" alt="">
                                                </a>
                                            </if>

                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="v-pos-info">
                                            <h4 class="mt-25 mb-25">@item.Name</h4>
                                            <ul class="list-unstyled pos-details">
                                                <li>
                                                    <span>@Localizer["compnay_name"]</span>
                                                    <span>@item.VendorName</span>
                                                </li>
                                                <li>
                                                    <span>@Localizer["system_type"]</span>
                                                    <span>@item.TypeName</span>
                                                </li>
                                                <li>
                                                    <span>@Localizer["specialization"]</span>
                                                    <span>@item.SectorName</span>
                                                </li>
                                            </ul>
                                            <p class="pos-description">
                                                @Html.Raw(item.About)
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="mt-25 bg-light-lime p-3 ">
                                            <ul class="list-unstyled pos-attribute">
                                                @{
                                                    int count = 0;

                                                }
                                                @foreach (var opt in item.Specifications)
                                                {
                                                    if (count == 5)
                                                    {
                                                        break;
                                                    }
                                                    @foreach (var val in opt.Values)
                                                    {
                                                        if (count == 5)
                                                        {
                                                            break;
                                                        }
                                                        <li>
                                                            <i class="fas fa-check-circle"></i>
                                                            <small>@val.Value</small>
                                                        </li>
                                                        count++;
                                                    }

                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="bg-light-lime text-center p-y-40">
                    <a asp-action="CreatePOS" class="btn c-green">
                        <i class="fas fa-plus-circle fz-50"></i>
                        <br>
                        <span class="mt-15 d-inline-block ">@Localizer["add_new_system"]</span>
                    </a>
                </div>
            </div>
        </section>
    </if>


    <if exclude-if="Model.Data != null">
        <section class="vendor-page pt-75 pb-50" data-fix-height>
            <div class="container">
                <div class="bg-light-lime text-center p-y-40">
                    <a asp-action="CreatePOS" class="btn c-green">
                        <i class="fas fa-plus-circle fz-50"></i>
                        <br>
                        <span class="mt-15 d-inline-block ">@Localizer["add_new_system"]</span>
                    </a>
                </div>
            </div>
        </section>
    </if>

</if>







<div class="modal fade" id="DeletePosModal" tabindex="-1" role="dialog" aria-labelledby="DeletePosModal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-body p_25">
                <p>@Localizer["remove_pos_from_system"]</p>

            </div>
            <div class="modal-footer no-border">
                <button type="button" class="btn btn-outline-danger p-x-25" id="delete-pos">@Localizer["delete"]</button>
                <button type="button" class="btn btn-link c-gray" data-dismiss="modal">@Localizer["cancel"]</button>
            </div>
        </div>
    </div>
</div>


<div class="modal modal-reason fade" tabindex="-1" role="dialog" id="ReasonPosModal">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center">
                    <strong>@Localizer["current_status"]</strong>
                    <span class="badge badge-pill c-white" id="pos_status"></span>
                </div>
                <hr />
                <strong>@Localizer["l_notes"]</strong>
                <p class="reason pt-10 c-gray-dark" id="reason-text"></p>
            </div>
            <div class="modal-footer no-border">
                <button type="button" class="btn btn-outline-dark" data-dismiss="modal">@Localizer["close"]</button>
            </div>
        </div>
    </div>
</div>



@section Footer{
    <script src="~/Portal/js/carousel.min.js"></script>
    <script src="~/Portal/js/vendor.min.js"></script>


    <script>
        $('#ReasonPosModal').on('show.bs.modal', function (event) {
          var button = $(event.relatedTarget)
          var note = button.data('msg');
          var status = button.data('status');
          var options = button.data('options');
          var modal = $(this);
          modal.find('#reason-text').html(note);
          modal.find('#pos_status').html(status).addClass(options);
        })
    </script>
}