
@model List<AttributeDto>
@{
    string[] filters = Context.Request.Query["f"].ToArray();
    string[] typesQuery = Context.Request.Query["t"].ToArray();
} 

<h5 class="heading-large mb-25 c-blue"> @Localizer["filter_search_results"]</h5>

<svg style="display:none;">
    <symbol id="arrow" viewBox="0 0 612 612">
        <path fill="#999" d="M604.501,134.782c-9.999-10.05-26.222-10.05-36.221,0L306.014,422.558L43.721,134.782
				c-9.999-10.05-26.223-10.05-36.222,0s-9.999,26.35,0,36.399l279.103,306.241c5.331,5.357,12.422,7.652,19.386,7.296
				c6.988,0.356,14.055-1.939,19.386-7.296l279.128-306.268C614.5,161.106,614.5,144.832,604.501,134.782z" />
    </symbol>
</svg>

<div class="filter-widgets white-panel">
    <form asp-action="index" method="get" id="filtersForm" data-action="@Url.Action("search")">
        <input type="hidden" name="slug" value="@ViewBag.ActiveSector" />
        <input type="hidden" name="search" value="@Context.Request.Query["Search"]" />
        <if include-if="ViewBag.types != null">
            @{List<TypeDto> types = (List<TypeDto>)ViewBag.types;}
            <if include-if="types.Count > 0">
                <div class="filter-widget">
                    <a class="widget-title" data-toggle="collapse" href="#collapse-types" role="button" aria-expanded="true" aria-controls="collapse-types">
                        <span>
                            @Localizer["system_type"]
                        </span>
                        <svg xmlns="http://www.w3.org/2000/svg">
                            <use xlink:href="#arrow"></use>
                        </svg>
                    </a>
                    <div class="collapse widget-content show" id="collapse-types">
                        <ul class="list-unstyled options-list">
                            @foreach (TypeDto type in types)
                            {
                                <li class="form-group form-check option-item">
                                    <input type="checkbox" class="form-check-input" name="t" id="type-@type.Id" value="@type.Id" @(typesQuery.Contains(type.Id.ToString()) ? "checked" : "")>
                                    <label class="form-check-label" for="type-@type.Id">@type.Name </label>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

            </if>
        </if>
        @foreach (var attr in Model)
        {
            <if include-if="attr.Values != null && attr.Values.Count > 0">
                <div class="filter-widget">
                    <a class="widget-title" data-toggle="collapse" href="#collapse-@attr.Id" role="button" aria-expanded="true" aria-controls="collapse-@attr.Id">
                        <span>
                            @attr.Name
                        </span>
                        <svg xmlns="http://www.w3.org/2000/svg">
                            <use xlink:href="#arrow"></use>
                        </svg>
                    </a>
                    <div class="collapse widget-content show" id="collapse-@attr.Id">
                        <ul class="list-unstyled options-list">
                            @foreach (var val in attr.Values)
                            {
                                <li class="form-group form-check option-item">
                                    <input type="checkbox" class="form-check-input" name="f" id="Check-@val.Id" value="@val.Id" @(filters.Contains(val.Id.ToString()) ? "checked" : "")>
                                    <label class="form-check-label" for="Check-@val.Id">@val.Name </label>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </if>
        }
    </form>
</div>
