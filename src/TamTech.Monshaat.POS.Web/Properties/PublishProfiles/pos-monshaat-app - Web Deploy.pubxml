<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <ResourceId>/subscriptions/5b4a8d62-433e-4dcc-a9a4-6914484b053e/resourceGroups/TamCMS-Dev/providers/Microsoft.Web/sites/pos-monshaat-app</ResourceId>
    <ResourceGroup>TamCMS-Dev</ResourceGroup>
    <PublishProvider>AzureWebSite</PublishProvider>
