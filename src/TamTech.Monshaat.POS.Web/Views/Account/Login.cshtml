@using System.Collections.Generic
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Authentication
@model LoginViewModel
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewData["Title"] = Localizer["login"].Value;
}

<section class=" pt-75  pb-50" data-fix-height>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">

                <div class="text-center mb-25">
                    <img src="~/Identity/img/logo.png" width="300" />
                </div>
                <div class="white-panel p_25">
                    <header class="mb-15 mt-25 p-x-15">
                        <h3>
                            @Localizer["login"]
                        </h3>
                    </header>
                    <div class="p-x-15 p-y-25">
                        <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" class="form " role="form">
                            <div asp-validation-summary="All" class="text-danger"></div>
                            <div class="form-group">
                                <label asp-for="Email" class=" control-label">@Localizer["t_username"]</label>
                                <input asp-for="Email" class="form-control form-control-lg"  required/>
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label class="control-label">@Localizer["password"]</label>
                                <input asp-for="Password" class="form-control form-control-lg"  required/>
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <div class="form-group d-flex justify-content-between align-items-md-center">
                                @*<span class="d-inline-flex align-items-center justify-content-around">
                                    <input class="tgl tgl-flat toggle__publish" type="checkbox" asp-for="RememberMe" />
                                    <label class="tgl-btn" for="RememberMe"></label>
                                    <label for="RememberMe" class="m-x-15 mt-5 select-none">@Localizer["RememberMe"]</label>
                                </span>*@
                                <button type="submit" class="btn btn-success">@Localizer["login"]</button>
                            </div>

                            <hr />
                            <div class="row justify-content-between align-items-center">
                                <div class="col">
                                    @Localizer["you_dont_have_account"]
                                    <a asp-action="Register" asp-route-returnurl="@ViewData["ReturnUrl"]">@Localizer["create_account"]</a>
                                </div>
                                
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>


@section Scripts {
    <script src="~/auth/js/validation.min.js"></script>

<script>
    $('.form').validate({
    errorClass: "invalid_field",
    validClass: "valid_field",
        ignore: ".ignore"
    });
</script>
}
