@model List<SectionDto>
@{

    ViewData["pageTitle"] = "";
        ViewData["Title"] = Localizer["sections"];
        ViewData["pageTitle"] = Localizer["sections"];

    Layout = "_Layout";
    ViewData["ImageURl"] = @Url.Content("~/portal/img/about.jpg");

}
@{ 
    List<SlugModel> mod = new List<SlugModel>();
}

<partial name="~/Areas/Portal/Views/Shared/partials/_Header.cshtml" model="mod" />

@await Html.PartialAsync("~/Areas/Portal/Views/Shared/partials/_PageHeader.cshtml", @ViewData)

 

<section>
    <div class="container">
        <div class="row">
            @foreach(SectionDto sec in Model)
            {
               <div class="col-md-4 col-xs-12 col-sm-4">
                   <div class="section">
                       <img src="@sec.MainImage" alt="Alternate Text"  class="img-fluid"/>
                       <p>
                           @sec.Summary
                       </p>
                       <a href="@Url.Action("s", "Posts", new { slug = sec.SlugHierarchy }).Replace("%2F", "/")">@sec.Title</a>
                   </div>
               </div>
            }
        </div>
    </div>
</section>