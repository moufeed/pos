<section class="error-section" data-fix-height>
    <div class="container">
        <div class="row justify-content-center align-items-center">
            <div class="col-12 col-md-10 col-lg-6 text-center pt-75 mt-50">
                <i class="fas fa-exclamation-triangle fz-60 c-green"></i>
                <p class="display-3 mt-25">@Localizer["p_error_title"]</p>

                <p class="lead">
                    @Localizer["p_error_message"]
                </p>
                <a asp-action="index" asp-controller="home" class="btn btn-outline-d-green mt-30">
                    @Localizer["back_to_hompage"]
                </a>
            </div>
        </div>
    </div>

</section>
<div class="top-footer bg-light-lime pt-75 text-center mt-50">
    <img src="~/portal/img/footer.png" alt="footerimage">
</div>