
@model ServiceList

@{ 
    var action = ViewContext.RouteData.Values["Action"].ToString();
    var slug = (ViewContext.RouteData.Values["Slug"] != null) ? ViewContext.RouteData.Values["Slug"].ToString()  : null;
}





<nav class="my-4">
    <ul class="pagination">

        @if (Model.Pagination != null && Model.Pagination.TotalPages > 1)
        {
            @if (Model.Pagination.PreviousPage)
            {
        <li class="page-item ">
            @{ int PreviousPage = Int32.Parse(Model.Pagination.PageNumber) - 1; }

            @if (slug != null && !string.Equals(action, "index" ,StringComparison.OrdinalIgnoreCase))
            {
            <a class="page-link" href="@Url.Action("s", "services", new { PageNumber = PreviousPage.ToString() ,slug = slug })" tabindex="-1">@Localizer["Previous"]</a>
            }
            else
            {
            <a class="page-link" href="@Url.Action("index", "services", new { PageNumber = PreviousPage.ToString() })" tabindex="-1">@Localizer["Previous"]</a>
            }



        </li>
            }

            @for (int i = 1; i <= Model.Pagination.TotalPages; i++)
            {
                int num = Int32.Parse(Model.Pagination.PageNumber);

        <li class="page-item @( num == i ? "active" : "" ) ">
            @if (slug != null && !string.Equals(action, "index", StringComparison.OrdinalIgnoreCase))
            {
                <a class="page-link" href="@Url.Action("s", "services", new { PageNumber = i.ToString() ,slug = slug })">@i</a>
            }
            else
            {
                <a class="page-link" href="@Url.Action("index", "services", new { PageNumber = i.ToString() })">@i</a>
            }

        </li>
            }

            @if (Model.Pagination.NextPage)
            {
                <li class="page-item ">
                    @{ int NextPage = Int32.Parse(Model.Pagination.PageNumber) + 1; }

                    @if (slug != null && !string.Equals(action, "index", StringComparison.OrdinalIgnoreCase))
                    {
                        <a class="page-link" href="@Url.Action("s", "services", new { PageNumber = NextPage.ToString() ,slug = slug})" tabindex="-1">@Localizer["Next"]</a>
                    }
                    else
                    {
                        <a class="page-link" href="@Url.Action("index", "services", new { PageNumber = NextPage.ToString() })" tabindex="-1">@Localizer["Next"]</a>
                    }

                </li>
            }

        }


    </ul>
</nav>