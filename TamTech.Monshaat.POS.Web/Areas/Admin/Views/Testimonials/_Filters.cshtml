@model TamTechSDK.Web.Models.Shared.Filters.Filter


<form class="form-horizontal forn-new form-label-left p-3 filter-form" asp-action="index" method="get" name="filterForm">

    <div class="row">
        <div class="form-group col-md-4 col-sm-4 col-lg-2">
            <label for="sortPage">@Localizer["sort_by"]</label>
            <select asp-for="SortBy" asp-items="ViewBag.sortList"
                    onchange="document.filterForm.submit()"
                    class="form-control m-x-1 select_no-search"></select>
        </div>

        <div class="form-group col-md-4 col-sm-4 col-lg-2">
            <label for="sortPage">@Localizer["f_name"]</label>
            <input type="text" asp-for="AuthorName" class="form-control m-x-1" style="height: 38px;" />
        </div>

        <div class="form-group col-md-4 col-sm-4 col-lg-2">
            <label for="section">@Localizer["f_rating"]</label>
            <select asp-for="Rating" asp-items="ViewBag.sectionList"
                    class="form-control m-x-1 select_no-search">
                <option value="">@Localizer["all"]</option>
                <option value="0"> &#xf006; &#xf006; &#xf006; &#xf006; &#xf006;</option>
                <option value="1"> &#xf005; &#xf006; &#xf006; &#xf006; &#xf006;</option>
                <option value="2"> &#xf005; &#xf005; &#xf006; &#xf006; &#xf006; </option>
                <option value="3"> &#xf005; &#xf005; &#xf005; &#xf006; &#xf006;</option>
                <option value="4"> &#xf005; &#xf005; &#xf005; &#xf005; &#xf006;</option>
                <option value="5"> &#xf005; &#xf005; &#xf005; &#xf005; &#xf005;</option>
            </select>
        </div>

        <div class="form-group col-md-4 col-sm-4 col-lg-2">
            <label for="sortPage">@Localizer["t_visibility"]</label>
            <select asp-for="Visibility"
                    asp-items="ViewBag.visibilityList"
                    class="form-control m-x-1 select_no-search">
                <option value="null">@Localizer["all"]</option>
            </select>
        </div>

        <div class="form-group col-md-4 col-lg-3 col-sm-4">

            <button type="submit" class="btn btn-info p-x-5 m-t5">@Localizer["search"]</button>

            <if exclude-if="@ViewBag.showReset">
                <a href="@Url.AdminUrl("index","testimonials")" class="btn btn-link p-x-2 m-t5 c-red"> <i class="fa fa-times-circle "></i> @Localizer["reset"]</a>
            </if>
        </div>


        <div class="form-group col-md-3 pull-right flip-dir col-lg-1 col-sm-2 col-xs-12">
            <label for="sortPage">@Localizer["page_size"]</label>
            <select asp-for="PageSize"
                    asp-items="ViewBag.pagesizes"
                    onchange="document.filterForm.submit()"
                    class="form-control m-x-1 select_no-search pagesize"></select>
        </div>
    </div>
</form>
<hr class="m-y-2" />
