
@model TestimonialFormVM

@{
    ViewData["UnitTestPageClass"] = "ut-testimonials-form";
    ViewData["Title"] = ViewBag.IsEditMode ? Localizer["edit_testimonial"] : Localizer["create_testimonial"];

    var activeLang = DataCultureHelper.GetCurrent(Context.Request.Query);
}


<div class="clearfix">
    <div class="page-title">
        <div class="title_left">
            <h3>@(ViewBag.IsEditMode ? Localizer["edit_testimonial"] : Localizer["create_testimonial"])<small></small></h3>
        </div>
        <div class="title_right dropdown">
            <a asp-action="Index"
               class="btn btn-blue"><span class="fa fa-chevron-left"></span>@Localizer["back_to_list"]</a>
        </div>
    </div>
</div>





<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">


        @{
            if (ViewBag.IsEditMode)
            {
                ViewBag.LanguageTabsRouteValues = new Microsoft.AspNetCore.Routing.RouteValueDictionary {
                    { "id" , Model.Id}
                };
            }
            else
            {
                ViewBag.LanguageTabsRouteValues = new Microsoft.AspNetCore.Routing.RouteValueDictionary { };
            }

        }
        @await Html.PartialAsync("~/Areas/Admin/Views/Shared/partials/_LanguageTabs.cshtml")





        <div class="x_panel">
            <div class="x_content">

                <form asp-action="@(ViewBag.IsEditMode ? "edit" : "create")"
                      method="post"
                      class="form-horizontal forn-new form-label-left"
                      id="ServicesForm"
                      enctype="multipart/form-data">


                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" as class="alert alert-danger"></div>
                    }

                    <input type="hidden" name="Lang" value="@activeLang" />
                    <if include-if="ViewBag.IsEditMode">
                        <input type="hidden" asp-for="Id" class="ut-id" />
                    </if>

                    <div class="form-group clearfix">
                        <label asp-for="AuthorName" class="control-label col-md-2 col-sm-3 col-xs-12 ">@Localizer["f_name"] <i class="fa fa-asterisk c-red fz-10 "></i></label>
                        <div class="col-md-10 col-lg-9 col-sm-9 col-xs-12">
                            <input asp-for="AuthorName" class="form-control" required data-seo-name />
                            <span asp-validation-for="AuthorName" class="text-danger invalid_field"></span>
                        </div>
                    </div>

                    <div class="form-group clearfix">
                        <label asp-for="Company" class="control-label col-md-2 col-sm-3 col-xs-12 ">@Localizer["f_company"]  </label>
                        <div class="col-md-10 col-lg-9 col-sm-9 col-xs-12">
                            <input asp-for="Company" class="form-control" />
                            <span asp-validation-for="Company" class="text-danger invalid_field"></span>
                        </div>
                    </div>

                    <div class="form-group clearfix">
                        <label asp-for="Postion" class="control-label col-md-2 col-sm-3 col-xs-12 ">@Localizer["f_job_position"] <i class="fa fa-asterisk c-red fz-10 "></i></label>
                        <div class="col-md-10 col-lg-9 col-sm-9 col-xs-12">
                            <input asp-for="Postion" class="form-control" required />
                            <span asp-validation-for="Postion" class="text-danger invalid_field"></span>
                        </div>
                    </div>

                    <div class="form-group clearfix">
                        <label asp-for="Email" class="control-label col-md-2 col-sm-3 col-xs-12 ">@Localizer["f_email"] </label>
                        <div class="col-md-10 col-lg-9 col-sm-9 col-xs-12">
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger invalid_field"></span>
                        </div>
                    </div>

                    <div class="form-group clearfix">
                        <label asp-for="MainImage" class="control-label col-md-2 col-sm-3 col-xs-12 ">@Localizer["f_avater_image"]</label>
                        <div class="col-md-10 col-lg-9 col-sm-9 col-xs-12">

                            @if (!string.IsNullOrEmpty(Model.MainImage))
                            {
                                <img src="@Model.MainImage" style="max-width:300px" class="img-thumbnail m-b3" data-seo-image="@Model.MainImage">
                                <input type="hidden" name="MainImage" value="@Model.MainImage" />
                            }

                            <label class="form-control clearfix uploadfile">
                                <input type="file" name="NewMainImage" id="NewMainImage" class="upload-input" data-text="@Localizer["choose_file"]" accept="image/*" data-rule-filesize="800" />
                                <span class="url">@Localizer["choose_file"]</span>
                                <span class="file-btn"><i class="fa fa-search"></i> @Localizer["Browse"]</span>
                            </label>
                            <label id="NewMainImage-error" class="invalid_field" for="NewMainImage" style="display:none;"></label>
                            <span asp-validation-for="MainImage" class="text-danger invalid_field"></span>
                        </div>
                    </div>

                    <div class="form-group clearfix">
                        <label asp-for="DisplayOrder" class="control-label col-md-2 col-sm-3 col-xs-12 ">@Localizer["f_display_order"]</label>
                        <div class="col-md-10 col-lg-9 col-sm-9 col-xs-12">
                            <input asp-for="DisplayOrder" class="form-control" min="0" />
                            <span asp-validation-for="DisplayOrder" class="text-danger invalid_field"></span>
                        </div>
                    </div>

                    <div class="form-group clearfix">
                        <label asp-for="Rating" class="control-label col-md-2 col-sm-3 col-xs-12 ">@Localizer["f_rating"]</label>
                        <div class="col-md-10 col-lg-9 col-sm-9 col-xs-12">

                            <fieldset class="star_rating">
                                <input type="radio" id="star5" asp-for="Rating" value="5" /><label for="star5"></label>

                                <input type="radio" id="star4" asp-for="Rating" value="4" /><label for="star4"></label>

                                <input type="radio" id="star3" asp-for="Rating" value="3" /><label for="star3"></label>

                                <input type="radio" id="star2" asp-for="Rating" value="2" /><label for="star2"></label>

                                <input type="radio" id="star1" asp-for="Rating" value="1" /><label for="star1"></label>


                            </fieldset>
                            <span asp-validation-for="DisplayOrder" class="text-danger invalid_field"></span>
                        </div>
                    </div>

                    <div class="form-group clearfix">
                        <label asp-for="Title" class="control-label col-md-2 col-sm-3 col-xs-12 ">@Localizer["f_title"] </label>
                        <div class="col-md-10 col-lg-9 col-sm-9 col-xs-12">
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger invalid_field"></span>
                        </div>
                    </div>

                    <div class="form-group clearfix">
                        <label asp-for="Summary" class="control-label col-md-2 col-sm-3 col-xs-12 ">@Localizer["f_message"] <i class="fa fa-asterisk c-red fz-10 "></i></label>
                        <div class="col-md-10 col-lg-9 col-sm-9 col-xs-12">
                            <textarea asp-for="Summary" class="form-control" required rows="5" maxlength="1000" data-seo-description></textarea>
                            <span asp-validation-for="Summary" class="text-danger invalid_field"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-6 col-md-offset-2 col-sm-offset-4 col-sm-6 col-xs-12 ">
                            <input type="submit" class="btn btn-success p-x-5 ut-createbtn" name="save" value="@((ViewBag.IsEditMode) ? Localizer["Update"]  : Localizer["Create"] )">

                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>




@section  Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/Admin/js/validator.min.js"></script>
}
